# ─────────────────────────────────────────────────────────────
# TravelSync Pro — Environment Configuration
# Copy this file to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-32-char-string-in-production
PORT=3399
DEBUG=False

# ── Google AI ─────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Google Maps Platform ──────────────────────────────────────
# Enable: Maps JavaScript, Directions, Distance Matrix, Places, Geocoding
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ── Google Cloud Vision (OCR for receipts) ────────────────────
# Can reuse GOOGLE_MAPS_API_KEY if both enabled on same key
GOOGLE_VISION_API_KEY=

# ── Amadeus Travel API (Flights + Hotels) ─────────────────────
# Free sandbox: https://developers.amadeus.com/register
# Production: upgrade after testing
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# AMADEUS_ENV=production

# ── OpenWeatherMap (Weather Forecasts) ────────────────────────
# Free tier: 1000 calls/day — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ── Currency Exchange ─────────────────────────────────────────
# Open Exchange Rates: https://openexchangerates.org (free: 1000 req/month)
OPEN_EXCHANGE_APP_ID=
# Alternative: Fixer.io
FIXER_API_KEY=

# ── Zoho CRM ──────────────────────────────────────────────────
# Setup OAuth app at: https://api-console.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_ORG_ID=

# ── Google Cloud Storage (for uploaded documents) ─────────────
# Replaces local /static/uploads/ in production
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Database ──────────────────────────────────────────────────
# Leave empty to use SQLite (development)
# Set for Cloud SQL PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# ── Runtime / Caching ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3399
REDIS_URL=

# ── Google Cloud (Deployment) ─────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=asia-south1

# ── Notifications: WhatsApp (Twilio) ──────────────────────────
# Sign up at https://twilio.com/try-twilio (free $15 credit)
# Activate sandbox: Messaging > Try it out > WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# ── Notifications: Zoho Cliq (OAuth2 API) ─────────────────────
# 1. Create a Self Client at https://api-console.zoho.in
# 2. Generate code with scope: ZohoCliq.Channels.ALL,ZohoCliq.Bots.ALL
# 3. Exchange for refresh token
ZOHO_CLIQ_API_ENDPOINT=
ZOHO_CLIQ_CLIENT_ID=
ZOHO_CLIQ_CLIENT_SECRET=
ZOHO_CLIQ_REFRESH_TOKEN=
ZOHO_CLIQ_ACCESS_TOKEN=
# Shared secret for verifying incoming bot webhooks from Cliq.
# Set the same value in your Zoho Cliq bot configuration → Webhook → Token.
CLIQ_WEBHOOK_TOKEN=

# ── OTIS Voice Assistant ─────────────────────────────────────
# Deepgram STT: https://console.deepgram.com/
DEEPGRAM_API_KEY=
# ElevenLabs TTS (secondary): https://elevenlabs.io/
ELEVENLABS_API_KEY=
OTIS_ENABLED=true
OTIS_ADMIN_ONLY=false
OTIS_REQUIRE_CONFIRMATION=false
OTIS_WAKE_WORD=Hey Otis

# ── OTIS Indian Voice — Google TTS (PRIMARY, no extra package) ────────────────
# Step 1: Google Cloud Console → APIs & Services → Enable "Cloud Text-to-Speech API"
#         (use same project as GOOGLE_VISION_API_KEY / GOOGLE_MAPS_API_KEY)
# Step 2: Done — OTIS auto-uses genuine Indian voice
#
# Voice options:
#   en-IN-Neural2-C  ← clear Indian male   (default, recommended)
#   en-IN-Neural2-B  ← warmer Indian male
#   en-IN-Neural2-D  ← Indian female
#   en-IN-Wavenet-C  ← older male, free-tier safe
GOOGLE_TTS_VOICE=en-IN-Neural2-C
OTIS_TTS_PROVIDER=google
OTIS_STT_PROVIDER=google

# ── ElevenLabs voice settings (active when OTIS_TTS_PROVIDER=elevenlabs) ─────
# For Indian accent: elevenlabs.io/app/voice-library → search "Indian English male"
# → Add to library → copy voice ID → paste below
OTIS_VOICE_ID=
OTIS_VOICE_LABEL=Indian English Male
OTIS_VOICE_LANGUAGE=en-IN
OTIS_VOICE_GENDER=male
OTIS_VOICE_MODEL_ID=eleven_multilingual_v2
OTIS_VOICE_SPEED=0.96
OTIS_VOICE_PITCH=0.0
OTIS_VOICE_STABILITY=0.58
OTIS_VOICE_SIMILARITY=0.82
OTIS_VOICE_STYLE=0.0
OTIS_VOICE_USE_SPEAKER_BOOST=false
